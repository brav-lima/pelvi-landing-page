# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ID da Audience no Resend — https://resend.com/audiences
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Cadastro (landing -> pelvi-admin)
PELVI_ADMIN_API_URL=http://localhost:3000
CLINIC_EXTERNAL_API_KEY=xxxxxxxx

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Chaves de teste (sempre passam): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
